# Supabase (Paramètres du projet > API). La clé "anon" est publique : la sécurité repose sur les règles RLS.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Clé publique VAPID pour les notifications push (la clé privée est stockée côté serveur dans private.app_config)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
